# ─────────────────────────────────────────────────────────────
# Azure Blob Storage credentials
# Copy this file to `.env` and fill in your real values.
# The `.env` file is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# Full connection string from: Azure Portal > Storage account > Access keys
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net"

# Container the uploaded files land in (created automatically if missing)
AZURE_STORAGE_CONTAINER_NAME="etl-uploads"

# ─────────────────────────────────────────────────────────────
# App settings
# ─────────────────────────────────────────────────────────────

# Max upload size in megabytes (files larger than this are rejected)
MAX_UPLOAD_SIZE_MB=100

# ─────────────────────────────────────────────────────────────
# MySQL destination (used by the Airflow load stage)
# ─────────────────────────────────────────────────────────────
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="etl_user"
MYSQL_PASSWORD="change_me"
MYSQL_DATABASE="etl"
